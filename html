<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neymar Jr. Fan Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #101820;
            color: white;
        }

        header {
            background: #006b3c;
            padding: 25px;
            text-align: center;
        }

        header h1 {
            font-size: 35px;
        }

        nav {
            background: #111;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-weight: bold;
        }

        .hero {
            text-align: center;
            padding: 100px 20px;
            background: linear-gradient(135deg, #006b3c, #101820);
        }

        .hero h2 {
            font-size: 45px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .button {
            display: inline-block;
            background: #ffcc00;
            color: black;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        .about {
            padding: 50px 20px;
            text-align: center;
        }

        .about h2 {
            color: #ffcc00;
            margin-bottom: 20px;
        }

        .stats {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 30px;
        }

        .card {
            background: #1e2a35;
            padding: 30px;
            width: 220px;
            text-align: center;
            border-radius: 10px;
        }

        .card h3 {
            color: #ffcc00;
            margin-bottom: 10px;
        }

        footer {
            background: #000;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <header>
        <h1>NEYMAR JR.</h1>
        <p>Football Magic | Skills | Passion</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#career">Career</a>
    </nav>

    <section class="hero" id="home">
        <h2>Welcome to Neymar Jr. Fan Page</h2>
        <p>Celebrating the skills, creativity and football journey of Neymar Jr.</p>
        <a href="#about" class="button">Explore More</a>
    </section>

    <section class="about" id="about">
        <h2>About Neymar Jr.</h2>
        <p>
            Neymar Jr. is a Brazilian professional footballer
            known for his incredible dribbling, creativity,
            speed and goal-scoring ability.
        </p>
    </section>

    <section class="stats" id="career">

        <div class="card">
            <h3>Brazil</h3>
            <p>National Team</p>
        </div>

        <div class="card">
            <h3>Barcelona</h3>
            <p>Former Club</p>
        </div>

        <div class="card">
            <h3>PSG</h3>
            <p>Former Club</p>
        </div>

        <div class="card">
            <h3>Santos</h3>
            <p>Club Career</p>
        </div>

    </section>

    <footer>
        <p>© 2026 Neymar Jr. Fan Website | Created by Viswa</p>
    </footer>

</body>
</html>
